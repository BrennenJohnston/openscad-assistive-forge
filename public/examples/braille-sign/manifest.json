{
  "name": "Braille Sign",
  "description": "A two-part tactile sign: a letter plate with raised uppercase sans-serif letters, 16 mm tall on the capital I and raised 0.8 mm, and a braille plate below with the same text in contracted (Grade 2) braille. The split raised border joins into one frame when the plates are mounted together. These defaults follow ADA 703, but this tool does not guarantee compliance. Check the standard before installing.",
  "version": "1.2.0",
  "author": "OpenSCAD Assistive Forge contributors",
  "license": "GPL-3.0-or-later",
  "main": "braille_sign.scad",
  "files": ["braille_sign.scad"],
  "program": "braille-card-customizer",
  "brailleTranslation": {
    "mode": "sign",
    "capitals": "off",
    "lineParams": ["Line_1", "Line_2", "Line_3", "Line_4", "Line_5", "Line_6"],
    "textParams": [
      "sign_text_1",
      "sign_text_2",
      "sign_text_3",
      "sign_text_4",
      "sign_text_5",
      "sign_text_6"
    ],
    "tablesCatalog": "/liblouis/tables.json",
    "defaultTable": "en-ueb-g2.ctb",
    "capacityParams": {
      "cardWidth": "sign_width_mm",
      "cardHeight": "braille_plate_height_mm",
      "cellSpacing": "cell_spacing",
      "lineSpacing": "line_spacing",
      "charHeight": "char_height_mm",
      "letterSpacing": "letter_spacing",
      "border": "add_border",
      "borderWidth": "border_width_mm"
    }
  },
  "tags": [
    "braille",
    "accessibility",
    "sign",
    "signage",
    "ada",
    "liblouis",
    "tactile",
    "assistive-technology"
  ],
  "inspired_by": {
    "name": "Brennen Johnston (braille dot system)",
    "github": "BrennenJohnston",
    "reference": "https://github.com/BrennenJohnston/braille-sign-openscad"
  }
}
