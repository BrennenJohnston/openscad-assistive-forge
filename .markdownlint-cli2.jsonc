{
  "config": ".markdownlint.json",
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/.lighthouseci/**",
    "**/public/libraries/**",
    "**/public/wasm/**",
    "**/public/fonts/**",
    "TEST_REPORT.md",
    "docs/reference/OPENSCAD_LANGUAGE_REFERENCE.md",
    "**/.volkswitch/**",
    "**/.audit-scratch/**"
  ]
}
